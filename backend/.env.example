# Set these in your shell or hosting provider. The defaults are fine for local development.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Tehran
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SQLITE_PATH=db.sqlite3

# Shop rules (USD)
SHOP_SHIPPING_FEE=5.00
SHOP_FREE_SHIPPING_FROM=50.00

# Rate limits for login/register and discount-code checks
THROTTLE_AUTH=20/min
THROTTLE_DISCOUNT=30/min

# Set to True when served over HTTPS behind a proxy (secure cookies, HSTS, redirect)
DJANGO_HTTPS=False
