# Copy to .env.local.

# Where the browser reaches the Django API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Public address of this site (canonical links, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: where the Next.js *server* reaches the API, if different (e.g. http://backend:8000 in Docker).
# INTERNAL_API_URL=
